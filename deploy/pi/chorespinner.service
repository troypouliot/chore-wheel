[Unit]
Description=Chore Wheel kiosk browser
After=graphical.target network-online.target NetworkManager-wait-online.service
Wants=network-online.target NetworkManager-wait-online.service

[Service]
Type=simple
User=pi
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority
# 1. Wait for X11 display server :0 to be ready to render windows
ExecStartPre=/bin/sh -c 'until xset q > /dev/null 2>&1; do sleep 1; done'
# 2. Wait for network connection & backend HTTP 200 response
ExecStartPre=/bin/sh -c 'until curl -s --connect-timeout 2 http://192.168.0.10:8000/ > /dev/null; do sleep 1; done'
# 3. Settle window manager layout before launching
ExecStartPre=/bin/sleep 2
ExecStart=/usr/bin/chromium --kiosk --app=http://192.168.0.10:8000/ \
  --noerrdialogs --disable-infobars --no-first-run --disable-translate \
  --check-for-update-interval=31536000 --disable-pinch \
  --overscroll-history-navigation=0 --password-store=basic \
  --disable-session-crashed-bubble --disable-gpu \
  --start-maximized
# Auto-restart is OFF so using the kill button exits Chromium without auto-restarting.
# Use the desktop shortcut to relaunch when ready.
Restart=no
KillMode=control-group
ExecStop=/usr/bin/pkill -9 -f chromium

[Install]
WantedBy=graphical.target
